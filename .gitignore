# OMAR OS .gitignore
# Keep the repository free of secrets, local artifacts, and noise.

# Secrets / credentials (never commit)
.env
.env.*
*.key
*.pem
secrets.*
credentials.*
**/secrets/**
**/credentials/**

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# Build / output artifacts
dist/
build/
*.log

# Local-only knowledge/working files (if any tooling writes caches here)
.knowledge_cache/
